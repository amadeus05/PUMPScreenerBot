TELEGRAM_BOT_TOKEN=
NODE_ENV=production

# Market Data Providers Configuration
# Comma-separated list of exchanges to use
# Options: binance, bybit, okx
# Examples:
#   - Single exchange: MARKET_DATA_PROVIDERS=binance
#   - Multiple exchanges: MARKET_DATA_PROVIDERS=binance,bybit
#   - All exchanges: MARKET_DATA_PROVIDERS=binance,bybit,okx
MARKET_DATA_PROVIDERS=binance,bybit

# Data Aggregator Configuration
MAX_MINUTE_BUCKETS=70
MAX_15S_BUCKETS=300
MIN_BUCKET_SAMPLES=2
MAX_TRACKED_SYMBOLS=2000
SYMBOL_CHECK_INTERVAL=5000
FALLBACK_SHIFT_MULTIPLIER=2

# Trigger Engine Configuration
BATCH_PROCESSING_SIZE=10
TRIGGER_ENGINE_FLUSH_MS=200
TRIGGER_ENGINE_METRIC_CACHE_TTL_MS=500
MIN_CHECK_INTERVAL_MS=1000
TRIGGER_ENGINE_DEBOUNCE_THRESHOLD=3

# Logging Configuration
LOG_LEVEL=debug
DEBUG=false
DEBUG_TRIGGER_ENGINE=false

# Database Configuration
DATABASE_PATH=database.sqlite