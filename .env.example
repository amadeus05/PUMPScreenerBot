# ============================================
# TELEGRAM CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# MARKET DATA PROVIDERS CONFIGURATION
# ============================================

# --- METHOD 1: Simple configuration (all exchanges use same market type) ---
# Comma-separated list of exchanges
MARKET_DATA_PROVIDERS=binance
# Global market type for all exchanges
MARKET_TYPE=spot

# Examples:
# MARKET_DATA_PROVIDERS=binance
# MARKET_TYPE=futures
#
# MARKET_DATA_PROVIDERS=binance,bybit
# MARKET_TYPE=spot

# --- METHOD 2: Exchange-specific market types ---
# Each exchange can have its own market type
# MARKET_DATA_PROVIDERS=binance,bybit,okx
# BINANCE_MARKET_TYPE=futures
# BYBIT_MARKET_TYPE=spot
# OKX_MARKET_TYPE=futures

# --- METHOD 3: Inline configuration (highest priority) ---
# Format: exchange:marketType
# MARKET_DATA_PROVIDERS=binance:futures,bybit:spot,okx:futures

# ============================================
# Supported values:
# - Exchanges: binance, bybit, okx
# - Market types: spot, futures
# ============================================

# ============================================
# DATA AGGREGATOR CONFIGURATION
# ============================================
MAX_MINUTE_BUCKETS=70
MAX_15S_BUCKETS=300
MIN_BUCKET_SAMPLES=2
MAX_TRACKED_SYMBOLS=2000
SYMBOL_CHECK_INTERVAL=5000
FALLBACK_SHIFT_MULTIPLIER=2

# ============================================
# TRIGGER ENGINE CONFIGURATION
# ============================================
BATCH_PROCESSING_SIZE=10
TRIGGER_ENGINE_FLUSH_MS=200
TRIGGER_ENGINE_METRIC_CACHE_TTL_MS=500
MIN_CHECK_INTERVAL_MS=1000
TRIGGER_ENGINE_DEBOUNCE_THRESHOLD=3

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
DEBUG=false
DEBUG_TRIGGER_ENGINE=false

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_PATH=database.sqlite