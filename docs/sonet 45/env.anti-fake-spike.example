# ============================================
# 🚀 HYBRID DETECTOR (v4.0): KALMAN + SWING
# ============================================
# Добавьте эти параметры в ваш .env файл

# ============================================
# РЕЖИМ 1: KALMAN FILTER (Zero-Lag, рекомендуется!)
# ============================================

# Включить Kalman Filter (rocket navigation algorithm!)
# true = Kalman Filter (zero-lag, адаптивный)
# false = Swing Detection (структурный анализ)
USE_KALMAN_FILTER=true

# Шум процесса (насколько быстро меняется цена)
# Рекомендуется: 0.001-0.1
# Меньше = более гладкая линия
# Больше = более чувствительно
KALMAN_PROCESS_NOISE=0.01

# Шум измерения (насколько точны данные)
# Рекомендуется: 0.05-0.5
# Меньше = больше доверяем данным
# Больше = меньше доверяем данным
KALMAN_MEASUREMENT_NOISE=0.1

# Порог спайка (в стандартных отклонениях)
# 3.0 = 99.7% данных (рекомендуется)
# 2.0 = 95% данных (строже)
# 4.0 = 99.99% данных (мягче)
KALMAN_SPIKE_THRESHOLD=3.0

# ============================================
# РЕЖИМ 2: SWING DETECTION (если Kalman выключен)
# ============================================

# Swing Detection (правильный pump-алгоритм)
# Количество свечей для подтверждения локального экстремума
# Рекомендуется: 1-3
# 1 = более чувствительно (больше swing-точек)
# 2 = сбалансированно
# 3 = более строго (меньше swing-точек, только явные экстремумы)
SWING_LOOKBACK=2

# Минимальная длительность движения (миллисекунды)
# Рекомендуется: 15000-60000 (15-60 секунд)
# Меньше = более чувствительно, больше = более консервативно
MIN_MOVEMENT_DURATION_MS=30000

# Количество точек для подтверждения движения
# Рекомендуется: 1-3
# 0 = отключить проверку подтверждения
# 1 = минимальное подтверждение
# 2-3 = строгое подтверждение
CONFIRMATION_POINTS=2

# Использовать фильтр подтверждения
# true = требовать подтверждение движения (рекомендуется)
# false = детектировать все движения без подтверждения
USE_CLOSE_CONFIRMATION=true

# ============================================
# Примеры конфигураций под разные стратегии
# ============================================

# ========== KALMAN FILTER ПРОФИЛИ ==========

# ВОЛАТИЛЬНЫЙ РЫНОК (BTC, ETH):
# USE_KALMAN_FILTER=true
# KALMAN_PROCESS_NOISE=0.05
# KALMAN_MEASUREMENT_NOISE=0.15
# KALMAN_SPIKE_THRESHOLD=2.5
# MIN_MOVEMENT_DURATION_MS=15000

# СТАБИЛЬНЫЙ РЫНОК (стейблпейры):
# USE_KALMAN_FILTER=true
# KALMAN_PROCESS_NOISE=0.001
# KALMAN_MEASUREMENT_NOISE=0.05
# KALMAN_SPIKE_THRESHOLD=3.5
# MIN_MOVEMENT_DURATION_MS=60000

# НИЗКАЯ ЛИКВИДНОСТЬ (альткоины):
# USE_KALMAN_FILTER=true
# KALMAN_PROCESS_NOISE=0.1
# KALMAN_MEASUREMENT_NOISE=0.5
# KALMAN_SPIKE_THRESHOLD=2.0
# MIN_MOVEMENT_DURATION_MS=30000

# СКАЛЬПИНГ (быстрые движения):
# USE_KALMAN_FILTER=true
# KALMAN_PROCESS_NOISE=0.02
# KALMAN_MEASUREMENT_NOISE=0.1
# KALMAN_SPIKE_THRESHOLD=3.0
# MIN_MOVEMENT_DURATION_MS=10000

# ========== SWING DETECTION ПРОФИЛИ ==========

# КОНСЕРВАТИВНАЯ:
# USE_KALMAN_FILTER=false
# SWING_LOOKBACK=3
# MIN_MOVEMENT_DURATION_MS=60000
# CONFIRMATION_POINTS=3
# USE_CLOSE_CONFIRMATION=true

# СБАЛАНСИРОВАННАЯ:
# USE_KALMAN_FILTER=false
# SWING_LOOKBACK=2
# MIN_MOVEMENT_DURATION_MS=30000
# CONFIRMATION_POINTS=2
# USE_CLOSE_CONFIRMATION=true

# АГРЕССИВНАЯ:
# USE_KALMAN_FILTER=false
# SWING_LOOKBACK=1
# MIN_MOVEMENT_DURATION_MS=15000
# CONFIRMATION_POINTS=1
# USE_CLOSE_CONFIRMATION=true

