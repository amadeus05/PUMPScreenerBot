import { Injectable } from "../../shared/decorators";
import {
  IDataAggregatorService,
  IMetricChanges,
  ITriggerEngineService,
} from "../../domain/interfaces/services.interface";
import { Logger } from "../../shared/logger";

type Bucket = {
  open: number;
  close: number;
  high: number;
  low: number;
  count: number;
  firstTs: number;
  lastTs: number;
  highTs: number;
  lowTs: number;
};

type HealthStats = {
  totalSymbols: number;
  buckets15s: number;
  buckets1m: number;
  memoryEstimateMB: number;
  oldestData: number;
  newestData: number;
  warmupRejects: number;
  fallbacksUsed: number;
};

class SortedBucketMap {
  private map: Map<number, Bucket> = new Map();
  private sortedKeys: number[] | null = null;

  get size(): number { return this.map.size; }
  has(key: number): boolean { return this.map.has(key); }
  get(key: number): Bucket | undefined { return this.map.get(key); }

  set(key: number, value: Bucket): void {
    const isNew = !this.map.has(key);
    this.map.set(key, value);
    if (isNew) this.sortedKeys = null;
  }

  delete(key: number): boolean {
    const existed = this.map.delete(key);
    if (existed) this.sortedKeys = null;
    return existed;
  }

  getSortedKeys(): number[] {
    if (this.sortedKeys === null) {
      this.sortedKeys = [...this.map.keys()].sort((a, b) => a - b);
    }
    return this.sortedKeys;
  }

  keys(): IterableIterator<number> { return this.map.keys(); }
  values(): IterableIterator<Bucket> { return this.map.values(); }
  entries(): IterableIterator<[number, Bucket]> { return this.map.entries(); }
  [Symbol.iterator](): IterableIterator<[number, Bucket]> { return this.map[Symbol.iterator](); }
}

@Injectable()
export class DataAggregatorService implements IDataAggregatorService {
  private readonly logger = new Logger("DataAggregator");

  private buckets15s: Map<string, SortedBucketMap> = new Map();
  private buckets1m: Map<string, SortedBucketMap> = new Map();

  private lastKnownPrices: Map<string, number> = new Map();
  private lastUpdateTs: Map<string, number> = new Map();
  private firstSeen: Map<string, number> = new Map();
  private outOfOrderCount: Map<string, number> = new Map();

  // Real-time
  private lastTriggered: Map<string, number> = new Map();
  private realTimeTriggersCount = 0;
  private triggerEngine?: ITriggerEngineService | null = null;
  private lastProcessedBucketTime: Map<string, Map<number, number>> = new Map();

  // Config
  private readonly MAX_MINUTE_BUCKETS = Number(process.env.MAX_MINUTE_BUCKETS) || 70;
  private readonly MAX_15S_BUCKETS = Number(process.env.MAX_15S_BUCKETS) || 300;
  private readonly MIN_TRIGGER_PERCENT = Number(process.env.MIN_TRIGGER_PERCENT) || 1.0;
  private readonly MAX_TRACKED_SYMBOLS = Number(process.env.MAX_TRACKED_SYMBOLS) || 2000;
  private readonly SYMBOL_CHECK_INTERVAL = Number(process.env.SYMBOL_CHECK_INTERVAL) || 5_000;
  private readonly SYMBOL_TTL_MS = 24 * 60 * 60 * 1000;
  private readonly REALTIME_ENABLED = process.env.REALTIME_ENABLED !== 'false';
  private readonly REALTIME_COOLDOWN_RATIO = Number(process.env.REALTIME_COOLDOWN_RATIO) || 0.5;
  private readonly DEBUG = process.env.DEBUG === 'true';

  private lastSymbolCheck = 0;
  private totalUpdates = 0;
  private lastHealthCheck = 0;
  private readonly HEALTH_CHECK_INTERVAL = 5 * 60 * 1000;

  private warmupRejects = 0;
  private metricsCalculated = 0;
  private fallbacksUsed = 0;

  // ==================== PUBLIC API ====================
  public updatePrice(symbol: string, price: number, timestamp: number): void {
    if (!symbol || !Number.isFinite(price) || price <= 0 || !Number.isFinite(timestamp) || timestamp <= 0) {
      if (this.DEBUG) this.logger.warn(`Invalid update: ${symbol} ${price} ${timestamp}`);
      return;
    }

    const maxFuture = Date.now() + 60_000;
    const safeTs = Math.min(Math.floor(timestamp), maxFuture);

    this.lastKnownPrices.set(symbol, price);
    this.lastUpdateTs.set(symbol, safeTs);

    if (!this.firstSeen.has(symbol)) {
      this.firstSeen.set(symbol, safeTs);
      if (this.DEBUG) this.logger.debug(`New symbol: ${symbol}`);
    }

    this.addRawPoint(symbol, { timestamp: safeTs, price });

    // ✅ ИСПРАВЛЕНИЕ: проверяем закрытие свечи вместо обновления на лету
    if (this.REALTIME_ENABLED) {
      this.checkForBucketClosure(symbol, safeTs);
    }

    if (this.triggerEngine && typeof this.triggerEngine.onPriceUpdate === 'function') {
      try { void this.triggerEngine.onPriceUpdate(symbol, price); } catch (err) {
        this.logger.error(`Trigger engine onPriceUpdate failed: ${err}`);
      }
    }

    this.totalUpdates++;

    const now = Date.now();
    if (now - this.lastSymbolCheck > this.SYMBOL_CHECK_INTERVAL) {
      this.lastSymbolCheck = now;
      this.ensureSymbolLimit();
    }

    if (now - this.lastHealthCheck > this.HEALTH_CHECK_INTERVAL) {
      this.lastHealthCheck = now;
      this.logHealth();
    }
  }

  public getMetricChanges(symbol: string, timeIntervalMinutes: number): IMetricChanges | null {
    if (!symbol || timeIntervalMinutes <= 0) return null;
    return timeIntervalMinutes <= 2
      ? this.calculateBuckets(symbol, timeIntervalMinutes, 15_000, this.buckets15s)
      : this.calculateBuckets(symbol, timeIntervalMinutes, 60_000, this.buckets1m);
  }

  public getAllKnownSymbols(): string[] {
    const set = new Set<string>();
    for (const s of this.buckets15s.keys()) set.add(s);
    for (const s of this.buckets1m.keys()) set.add(s);
    for (const s of this.lastKnownPrices.keys()) set.add(s);
    return Array.from(set);
  }

  public getHistoryLength(symbol: string): number {
    const m1 = this.buckets1m.get(symbol)?.size ?? 0;
    const m15 = this.buckets15s.get(symbol)?.size ?? 0;
    return Math.max(m1, m15);
  }

  public getCurrentPrice(symbol: string): number {
    return this.lastKnownPrices.get(symbol) ?? 0;
  }

  public setTriggerEngine(engine: ITriggerEngineService): void {
    this.triggerEngine = engine;
  }

  // ==================== УТИЛИТЫ ДЛЯ РАСЧЁТА ПРОЦЕНТОВ ====================
  // ✅ ИСПРАВЛЕНИЕ: точный расчёт процента с избежанием floating-point ошибок
  private calculatePercentageChange(fromPrice: number, toPrice: number): number {
    if (fromPrice <= 0) return 0;

    const scale = 10_000_000; // 7 знаков после запятой

    const fromScaled = Math.round(fromPrice * scale);
    const toScaled = Math.round(toPrice * scale);

    if (fromScaled <= 0) return 0;

    const percentScaled = ((toScaled - fromScaled) * 100 * scale) / fromScaled;
    const percent = percentScaled / scale;

    return Math.round(percent * 10000) / 10000;
  }

  // ==================== КРИТИЧЕСКИ ИСПРАВЛЕННЫЙ РАСЧЁТ ====================
  private calculateBuckets(
    symbol: string,
    minutes: number,
    bucketSize: number,
    store: Map<string, SortedBucketMap>,
  ): IMetricChanges | null {
    const map = store.get(symbol);
    if (!map || map.size < 2) return null;

    const now = Date.now();
    const windowMs = minutes * 60_000;
    const windowStart = now - windowMs;

    const firstSeen = this.firstSeen.get(symbol) ?? now;
    if (now - firstSeen < windowMs) {
      this.warmupRejects++;
      return null;
    }

    const closedBuckets = this.getClosedBucketsInWindow(map, windowStart, now, bucketSize);
    if (closedBuckets.length < 2) return null;

    const triggerCandle = closedBuckets[closedBuckets.length - 1];
    // ✅ ИСПРАВЛЕНИЕ: используем точный расчёт
    const triggerChangePct = this.calculatePercentageChange(triggerCandle.open, triggerCandle.close);

    if (Math.abs(triggerChangePct) < this.MIN_TRIGGER_PERCENT) {
      return null;
    }

    const isUp = triggerChangePct > 0;

    let bestStartPrice = triggerCandle.open;
    let bestStartTs = triggerCandle.firstTs;
    let bestPercent = Math.abs(triggerChangePct);

    for (let i = closedBuckets.length - 2; i >= 0; i--) {
      const candle = closedBuckets[i];

      // ✅ ИСПРАВЛЕНИЕ: правильная логика для UP/DOWN
      // Для UP: ищем от OPEN текущей свечи вверх
      // Для DOWN: ищем от CLOSE текущей свечи вниз
      const percent = isUp
        ? this.calculatePercentageChange(candle.open, triggerCandle.close)
        : this.calculatePercentageChange(triggerCandle.close, candle.open);

      if (Math.abs(percent) >= this.MIN_TRIGGER_PERCENT && Math.abs(percent) > bestPercent) {
        bestPercent = Math.abs(percent);
        bestStartPrice = isUp ? candle.open : candle.close;
        bestStartTs = candle.firstTs;
      }
    }

    const durationSec = Math.floor((triggerCandle.lastTs - bestStartTs) / 1000);

    const result: IMetricChanges = {
      priceChangePercent: Number((isUp ? bestPercent : -bestPercent).toFixed(6)),
      currentPrice: triggerCandle.close,
      previousPrice: bestStartPrice,
    const triggerOpen = closedBucket.open;

    // Получаем threshold для интервала
    const activeIntervals = this.getActiveIntervals(symbol);
    const threshold = activeIntervals.find(([m]) => m === intervalMinutes)?.[1] ?? 0;

    if (threshold <= 0) return;

    // ========== ДВИЖЕНИЕ ВВЕРХ (close > open) ==========
    // ✅ ИСПРАВЛЕНИЕ: правильная логика UP
    // UP: ищем минимум в интервале, считаем от него до close
    if (triggerPrice > triggerOpen && minPrice > 0) {
      const rise = this.calculatePercentageChange(minPrice, triggerPrice);

      if (rise >= threshold) {
        const key = `${symbol}:${intervalMinutes}:UP`;
        const cooldown = intervalMinutes * 60_000 * this.REALTIME_COOLDOWN_RATIO;

        if (now - (this.lastTriggered.get(key) ?? 0) > cooldown) {
          if (this.DEBUG) {
            this.logger.info(
              `✅ TRIGGER UP: ${symbol} ${intervalMinutes}m ` +
              `${minPrice.toFixed(8)} → ${triggerPrice.toFixed(8)} = +${rise.toFixed(4)}%`,
            );
          }

          this.fireRealTimeTrigger(symbol, {
            type: 'UP',
            percent: rise,
            startPrice: minPrice,
            currentPrice: triggerPrice,
            startTime: minTs,
            currentTime: closedBucket.lastTs,
            interval: intervalMinutes,
          });

          this.lastTriggered.set(key, now);
          this.realTimeTriggersCount++;
        }
      }
    }
    // ========== ДВИЖЕНИЕ ВНИЗ (close < open) ==========
    // ✅ ИСПРАВЛЕНИЕ: правильная логика DOWN
    // DOWN: ищем максимум в интервале, считаем от него к close
    else if (triggerPrice < triggerOpen && maxPrice > 0) {
      const drop = this.calculatePercentageChange(maxPrice, triggerPrice);
      const dropPercent = Math.abs(drop); // Берем абсолютное значение

      if (dropPercent >= threshold) {
        const key = `${symbol}:${intervalMinutes}:DOWN`;
        const cooldown = intervalMinutes * 60_000 * this.REALTIME_COOLDOWN_RATIO;

        if (now - (this.lastTriggered.get(key) ?? 0) > cooldown) {
          if (this.DEBUG) {
            this.logger.info(
              `✅ TRIGGER DOWN: ${symbol} ${intervalMinutes}m ` +
              `${maxPrice.toFixed(8)} → ${triggerPrice.toFixed(8)} = -${dropPercent.toFixed(4)}%`,
            );
          }

          this.fireRealTimeTrigger(symbol, {
            type: 'DOWN',
            percent: dropPercent,
            startPrice: maxPrice,
            currentPrice: triggerPrice,
            startTime: maxTs,
            currentTime: closedBucket.lastTs,
            interval: intervalMinutes,
          });

          this.lastTriggered.set(key, now);
          this.realTimeTriggersCount++;
        }
      }
    }
  }

  private fireRealTimeTrigger(
    symbol: string,
    data: {
      type: 'UP' | 'DOWN';
      percent: number;
      startPrice: number;
      currentPrice: number;
      startTime: number;
      currentTime: number;
      interval: number;
    },
  ): void {
    if (!this.triggerEngine) return;

    const durationSec = Math.floor((data.currentTime - data.startTime) / 1000);

    const metrics: IMetricChanges = {
      priceChangePercent: data.type === 'UP' ? data.percent : -data.percent,
      currentPrice: data.currentPrice,
      previousPrice: data.startPrice,
      timeWindowSeconds: Math.max(1, durationSec),
    };

    if (this.DEBUG) {
      this.logger.info(
        `REAL-TIME ${data.type}: ${symbol} ${data.interval}m → ` +
        `${data.percent.toFixed(4)}% in ${durationSec}s ` +
        `(${data.startPrice.toFixed(8)} → ${data.currentPrice.toFixed(8)})`,
      );
    }

    try {
      if (typeof (this.triggerEngine as any).onRealTimeMetricChange === 'function') {
        void (this.triggerEngine as any).onRealTimeMetricChange(symbol, data.interval, metrics);
      } else if (typeof (this.triggerEngine as any).onMetricChange === 'function') {
        void (this.triggerEngine as any).onMetricChange(symbol, data.interval, metrics);
      }
    } catch (err) {
      this.logger.error(`Real-time trigger failed: ${err}`);
    }
  }

  private getActiveIntervals(symbol: string): Array<[number, number]> {
    if (!this.triggerEngine || typeof (this.triggerEngine as any).getActiveIntervals !== 'function') return [];
    try {
      return (this.triggerEngine as any).getActiveIntervals(symbol);
    } catch {
      return [];
    }
  }

  // ==================== MONITORING ====================
  public getBucketHealth(symbol: string, minutes: number): { availableBuckets: number; expectedBuckets: number; coveragePercent: number; missingBuckets: number } {
    const bucketSize = minutes <= 2 ? 15_000 : 60_000;
    const store = bucketSize === 15_000 ? this.buckets15s : this.buckets1m;
    const map = store.get(symbol);
    if (!map) return { availableBuckets: 0, expectedBuckets: 0, coveragePercent: 0, missingBuckets: 0 };

    const now = Date.now();
    const durationMs = minutes * 60_000;
    const endBucket = Math.floor(now / bucketSize) * bucketSize;
    const startBucket = Math.floor((now - durationMs) / bucketSize) * bucketSize;
    const expected = Math.round((endBucket - startBucket) / bucketSize) + 1;
    const available = map.getSortedKeys().filter(k => k >= startBucket && k <= endBucket).length;
    const coverage = expected === 0 ? 0 : Math.round((available / expected) * 100);

    return { availableBuckets: available, expectedBuckets: expected, coveragePercent: coverage, missingBuckets: expected - available };
  }

  public visualizeBuckets(symbol: string): void {
    // ... оригинальный метод без изменений
  }

  public getOutOfOrderStats(symbol?: string): Record<string, number> | number {
    if (symbol) return this.outOfOrderCount.get(symbol) ?? 0;
    return Object.fromEntries(this.outOfOrderCount);
  }

  public getHealthStats(): HealthStats {
    let buckets15Count = 0, buckets1mCount = 0, oldestTs = Date.now(), newestTs = 0;

    for (const map of this.buckets15s.values()) { buckets15Count += map.size; for (const [ts] of map) { oldestTs = Math.min(oldestTs, ts); newestTs = Math.max(newestTs, ts); } }
    for (const map of this.buckets1m.values()) { buckets1mCount += map.size; for (const [ts] of map) { oldestTs = Math.min(oldestTs, ts); newestTs = Math.max(newestTs, ts); } }

    const memoryEstimateMB = ((buckets15Count + buckets1mCount) * 80) / (1024 * 1024);

    return {
      totalSymbols: this.getAllKnownSymbols().length,
      buckets15s: buckets15Count,
      buckets1m: buckets1mCount,
      memoryEstimateMB: Math.round(memoryEstimateMB * 100) / 100,
      oldestData: oldestTs === Date.now() ? 0 : oldestTs,
      newestData: newestTs,
      warmupRejects: this.warmupRejects,
      fallbacksUsed: this.fallbacksUsed,
    };
  }

  // ==================== INGESTION ====================
  private addRawPoint(symbol: string, point: { timestamp: number; price: number }): void {
    this.updateBucket(symbol, point.timestamp, point.price, 15_000, this.buckets15s);
    this.updateBucket(symbol, point.timestamp, point.price, 60_000, this.buckets1m);
  }

  private updateBucket(symbol: string, ts: number, price: number, bucketSize: number, store: Map<string, SortedBucketMap>): void {
    let map = store.get(symbol);
    if (!map) { map = new SortedBucketMap(); store.set(symbol, map); }

    const bucketTime = Math.floor(ts / bucketSize) * bucketSize;
    let b = map.get(bucketTime);

    if (!b) {
      b = { open: price, close: price, high: price, low: price, count: 0, firstTs: ts, lastTs: ts, highTs: ts, lowTs: ts };
      map.set(bucketTime, b);
    }

    if (ts < b.firstTs) { b.open = price; b.firstTs = ts; }
    if (ts > b.lastTs) { b.close = price; b.lastTs = ts; }
    if (price > b.high) { b.high = price; b.highTs = ts; }
    if (price < b.low) { b.low = price; b.lowTs = ts; }
    b.count++;

    this.cleanupBuckets(store, symbol, bucketSize);
  }

  private cleanupBuckets(store: Map<string, SortedBucketMap>, symbol: string, bucketSize: number): void {
    const map = store.get(symbol);
    if (!map) return;
    const limit = bucketSize === 15_000 ? this.MAX_15S_BUCKETS : this.MAX_MINUTE_BUCKETS;
    const keys = map.getSortedKeys();
    if (keys.length <= limit) return;
    const removing = keys.length - limit;
    for (let i = 0; i < removing; i++) map.delete(keys[i]);
  }

  // ==================== LRU & TTL ====================
  private ensureSymbolLimit(): void {
    const now = Date.now();

    // TTL eviction
    for (const [symbol, lastUpdate] of this.lastUpdateTs.entries()) {
      if (now - lastUpdate > this.SYMBOL_TTL_MS) {
        this.evictSymbol(symbol);
      }
    }

    const total = this.lastUpdateTs.size;
    if (total <= this.MAX_TRACKED_SYMBOLS) return;

    const arr = [...this.lastUpdateTs.entries()].map(([s, ts]) => ({ s, ts }));
    arr.sort((a, b) => a.ts - b.ts);
    const removeCount = total - this.MAX_TRACKED_SYMBOLS;

    for (let i = 0; i < removeCount; i++) {
      this.evictSymbol(arr[i].s);
    }

    this.logger.warn(`LRU evicted ${removeCount} symbols`);
  }

  private evictSymbol(symbol: string): void {
    this.buckets15s.delete(symbol);
    this.buckets1m.delete(symbol);
    this.lastKnownPrices.delete(symbol);
    this.lastUpdateTs.delete(symbol);
    this.firstSeen.delete(symbol);
    this.outOfOrderCount.delete(symbol);
    this.lastProcessedBucketTime.delete(symbol);

    for (const key of [...this.lastTriggered.keys()]) {
      if (key.startsWith(`${symbol}:`)) this.lastTriggered.delete(key);
    }
  }

  private logHealth(): void {
    const stats = this.getHealthStats();
    const outOfOrderTotal = [...this.outOfOrderCount.values()].reduce((a, b) => a + b, 0);

    this.logger.info(
      `Health: symbols=${stats.totalSymbols} buckets(15s=${stats.buckets15s} 1m=${stats.buckets1m}) ` +
      `mem≈${stats.memoryEstimateMB}MB updates=${this.totalUpdates} realTimeTriggers=${this.realTimeTriggersCount} ` +
      `warmupRejects=${this.warmupRejects} outOfOrder=${outOfOrderTotal}`
    );
  }
}